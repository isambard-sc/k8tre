#!/bin/bash

# Automatically sets up your devbox environment whenever you cd into this
# directory via our direnv integration:

eval "$(devbox generate direnv --print-envrc)"

# check out https://www.jetify.com/docs/devbox/ide_configuration/direnv/
# for more details

if [ -d ".venv" ]; then
    echo "Activating virtual environment from .venv directory."
    source .venv/bin/activate
else
    echo "No .venv directory found. Skipping virtual environment activation."
    echo "To create a virtual environment, run: python -m venv .venv"
    echo "Or if you want to use uv run: uv venv"
    echo "Then activate it with: source .venv/bin/activate"
fi

if [ -f "kubeconfig" ]; then
    export KUBECONFIG="$PWD/kubeconfig"
    echo "KUBECONFIG set to $KUBECONFIG"
else
    echo "No kubeconfig file found in the current directory."
    echo "Please ensure you have a kubeconfig file here to interact with your Kubernetes cluster."
fi